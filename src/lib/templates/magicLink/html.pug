extends ../basicEmail

block content
  div(class="email-background", style=`background-image: url('${absoluteUrl}/static/images/request-confirmed.png'); background-repeat: no-repeat; background-size: cover;`)
    div(class="email-wrapper-outer")
      div(class="email")
        p(class="email__name") Dear #{firstName},
        p(class="email__text") You requested that we send you a link to make it easy to login to Column/. Well, your wish is our command! Here you go:
        a(class="email__button", href=`${linkToLogin}`) Sign in to Column/
        p(class="email__footer-text gap-top-40") Yours sincerely,
        p(class="email__footer-name") Jason Pontin
        p(class="email__subtext") Editor in Chief, Column/