doctype html
html(lang='en' xmlns='https://www.w3.org/1999/xhtml' xmlns:o='urn:schemas-microsoft-com:office:office')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    meta(name='x-apple-disable-message-reformatting')
    title
    //if mso
      style.
        table {border-collapse:collapse;border-spacing:0;border:none;margin:0;}
        div, td {padding:0;}
        div {margin:0 !important;}
      noscript
        xml
          o:officedocumentsettings
            o:pixelsperinch 96
    style
      include newBasicEmailFive.css
  body(style='margin:0;padding:0;word-spacing:normal;background-color:#FCF1E8;')
    div(role='article' aria-roledescription='email' lang='en' style='text-size-adjust:100%;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;')
      table(role='presentation' style='width:100%;border:none;border-spacing:0;')
        tbody
          tr
            td(align='center' style='padding:0;')
              //if mso
                table(role='presentation' align='center' style='width:750px;')
                  tbody
                    tr
                      td
              table(role='presentation' style='width:100%;max-width:750px;border:none;border-spacing:0;text-align:left;font-family:Arial,sans-serif;line-height:22px;')
                tbody
                  tr
                    td(style='padding:40px 30px 30px 30px;text-align:center;font-size:24px;font-weight:bold;')
                      a(href='http://joincolumn.com/' style='text-decoration:none;')
                        img(style='width:80%;max-width:392px;height:auto;border:none;text-decoration:none;color:#ffffff;' src='https://column-static.s3.us-east-2.amazonaws.com/Shape.png' alt='Logo')
                  tr
                    td(style='text-align:center;font-family:Arial,sans-serif;font-size:20px;line-height:32px;color:#666666;padding:20px')
                      | Hi #{firstName},
                  tr
                    td(style='text-align:center;padding:10px 0px 0px 0px;')
                      block large_content
                  tr
                    td(style='text-align:center;padding-top:50px')
                      block text_content
                  tr
                    td(style='text-align:center;padding-top:10px')
                      block button_content
              table(role='presentation' style='width:100%;max-width:750px;max-border:none;border-spacing:0;text-align:center;font-family:Arial,sans-serif;line-height:22px;margin-top:42px;margin-bottom:32px')
                tbody
                  tr
                    td(style='text-align:center;')
                      .left_buffer(style='text-align:left;width:180px;')
                        p(style='color:#999999;font-family:Arial, sans-serif;font-size:20px;')
                          | Yours Sincerely,
                        img(style='max-width:150px;height:auto;border:none;text-decoration:none;color:#ffffff;' src='https://column-static.s3.us-east-2.amazonaws.com/Signature.png')
                        p(style='color:#999999;font-family:Arial, sans-serif;font-size:16px;')
                          | Social Secretary & Editor
                          br
                          |  in Chief Column/
                    td(style='text-align:center;')
                      img(style='max-width:150px;height:auto;border:none;text-decoration:none;color:#ffffff;' src='https://column-static.s3.us-east-2.amazonaws.com/Circle+Stamp.png')
              //if mso
