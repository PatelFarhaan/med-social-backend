extends ../basicEmail

block content
  div(class="email-background", style=`background-image: url('${absoluteUrl}/static/images/invitation.png'); background-repeat: no-repeat; background-size: cover;`)
    div(class="email-wrapper-outer")
      div(class="email")
        p(class="email__name") Dear #{firstName},
        p(class="email__text") You received an invitation to join Column/, however, you didn’t accept it in time.
        p(class="email__text") If you want, you can request an invitation by yourself, or ask to be invited again.
        a(class="email__button gap-bottom-40", href="#{actionLink}") Request an Invitation
        p(class="email__footer-text gap-top-40") Yours sincerely,
        p(class="email__footer-name") Jason Pontin
        p(class="email__subtext") Editor in Chief, Column/