extends ../newBasicEmailSeven

block header_template
  p.top_buffer(style='\
  font-family: Times, sans-serif;\
  white-space: nowrap;\
  letter-spacing: 4px;\
  ')
    | NEW
    br
    | SUBSCRIBER

block upper_text_content
  div(style='\
  display: inline-block;\
  width: 90%;\
  max-width: 590px;\
  vertical-align: top;\
  font-family: Arial, sans-serif;\
  font-size: 20px;\
  color: #666666;\
  ')
    p(style='margin-top: 0px; line-height: 32px')
      | You have a new Column subscriber!
      | You might want to welcome them.

block img_content
    a(href=`${callToActionUrl}` style='text-decoration:none;')
    img(style='width:311px;max-width:392px;height:auto;border:none;text-decoration:none;color:#ffffff;' src=`https://column-static.s3.us-east-2.amazonaws.com/column-snapshots/${columnSlug}.png` alt='Column')

block button_content
  p(style='margin: 0; text-align: left')
    a.button_link(href=`${callToActionUrl}` style='\
    background: #3d8f44;\
    text-decoration: none;\
    color: #ffffff;\
    border-radius: 8px;\
    display: inline-block;\
    mso-padding-alt: 0;\
    text-underline-color: none;\
    font-size: Arial, sans-serif;\
    letter-spacing: 3.2px;\
    font-size: 12px;\
    ')
      //if mso
        i(style='\
        letter-spacing: 25px;\
        mso-font-width: -100%;\
        mso-text-raise: 20pt;\
        ')  
        //
          [endif]
      span(style='mso-text-raise: 10pt; font-weight: normal') VIEW MEMBERS
      //if mso
        i(style='letter-spacing: 25px; mso-font-width: -100%')  
        //
          [endif]