extends ../basicEmail3

block content
  div(class="email")
    p(class="email__title") CHANGE EMAIL
    p(class="email__text").
      Hi #{firstName},#[br]#[br]
      You requested to change your email on Column/. Click this button to change it:
    div(class="text_center")
      a(class="email__button", href=`${callToActionUrl}`) CHANGE EMAIL
    br
    p(class="email__text") If you did not request this, please ignore this email or reply to let us know. This change email is valid for the next 30 minutes.
