extends ../basicEmail3

block content
  div(class="email")
    p(class="email__title") RESET PASSWORD
    p(class="request__text").
      Hi #{firstName},#[br]#[br]
      You requested to reset your password on Column/. Click this button to reset it:
    div(class="div_center")
      a(class="email__button", href=`${callToActionUrl}`) RESET PASSWORD
    p(class="request__text") If you did not request this, please ignore this email or reply to let us know. This password reset is valid for the next 30 minutes.
