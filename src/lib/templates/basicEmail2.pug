doctype strict
html(xmlns="https://www.w3.org/1999/xhtml")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width initial-scale=1.0")
    meta(name="color-scheme", content="only")
    meta(name="supported-color-schemes", content="light dark")
    style
      include basicEmail2.css
  body
    div(class="header")
      div(class="header_column_image__div")
       img(class="header_column_image__logo", src=`${absoluteUrl}/static/images/logo.png`)
      div(class="header_statue_image__div")
        img(class="header_statue_image__logo", src=`${absoluteUrl}/static/images/statue.png`)
    block content
    div(class="column_image")
      div(class="column_image__div")
        img(class="footer_column_image__logo", src=`${absoluteUrl}/static/images/columns.png`)
    block ps
    div(class="footer")
      div(class="footer_signature__div")
        p(class="footer_yours_sincerely__text") Yours sincerely,
        img(class="footer_signature__logo", src=`${absoluteUrl}/static/images/signature.png`)
        p(class="footer_alina__text") Alina Hart
        p(class="footer_column_secretary__text") Column/ Social Secretary
      div(class="footer_stamp__div")
        img(class="footer_stamp__logo", src=`${absoluteUrl}/static/images/stamp.png`)
