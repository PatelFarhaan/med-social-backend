extends ../basicEmail2

block content
  div(class="email")
    p(class="email__name") Hi #{firstName},
    p(class="email__title") Sadly, you don't meet our requirements to obtain a Nom de Plume.
    p(class="email__text") Still want to participate in the conversation? We'd love for you to be a member under your real name! Please follow the link below to finish signing up.
    a(class="email__button", href=`${callToActionUrl}`) FINISH SIGNING UP