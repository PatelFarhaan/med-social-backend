extends ../basicEmail2

block content
  div(class="email")
    p(class="email__name") Hi #{firstName},
    p(class="email__title") We’ve reviewed your request and think you'd be a great addition to Column/.
    p(class="email__text") You can finish signing up by clicking a button bellow.
    a(class="email__button", href=`${callToActionUrl}`) FINISH SIGNING UP
block ps
  div(class="ps")
    p(class="ps__text").
      Column/ is a new social network dedicated to signal over noise. #[br]
      If Twitter is a library crossed with a civil war, we’re a library crossed with a dinner party. #[br]#[br]
      Can't wait to see you there!