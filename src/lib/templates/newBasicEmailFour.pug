doctype html
html(lang='en' xmlns='https://www.w3.org/1999/xhtml' xmlns:o='urn:schemas-microsoft-com:office:office')
  head
    meta(charset='utf-8')
    meta(name='viewport' content='width=device-width,initial-scale=1')
    meta(name='x-apple-disable-message-reformatting')
    title
    //if mso
      style.
        table {border-collapse:collapse;border-spacing:0;border:none;margin:0;}
        div, td {padding:0;}
        div {margin:0 !important;}
      noscript
        xml
          o:officedocumentsettings
            o:pixelsperinch 96
    style
      include newBasicEmailFour.css

  body(style='margin:0;padding:0;word-spacing:normal;background-color:#f5f4f0;')
    div(role='article' aria-roledescription='email' lang='en' style='text-size-adjust:100%;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%;')
      table(role='presentation' style='width:100%;border:none;border-spacing:0;')
        tbody
          tr
            td(align='center' style='padding:0;')
              //if mso
                table(role='presentation' align='center' style='width:750px;')
                  tbody
                    tr
                      td
              table(role='presentation' style='width:100%;max-width:750px;border:none;border-spacing:0;text-align:left;font-family:Arial,sans-serif;line-height:22px;margin-top:47px')
                tbody
                  tr
                    td(style='text-align:center;font-family:Arial,sans-serif;font-size:20px;line-height:32px;color:#666666')
                      | Hi #{firstName},
                  tr
                    td(style='text-align:center;padding:20px 0px 0px 0px;')
                      .font_size(style='display:inline-block;width:90%;max-width:590px;vertical-align:top;font-family:Times,sans-serif;color:#000000;')
                        p(style='margin-top:0;letter-spacing:0.05em') YOU'VE BEEN INVITED TO COLUMN/ BY #{fromFirstName}. 
                  tr
                    td.message_td(style='text-align:center;')
                      div(style='display:inline-block;width:90%;max-width:590px;vertical-align:top;font-family:Arial,sans-serif;font-size:20px;;color:#666666;')
                        p(style='margin-top:0px;line-height:32px;')
                          | You can finish signing up by clicking the button below.
                  tr
                    td(style='text-align:center;padding-top:20px')
                      p(style='margin:0;text-align:center;')
                        a.button_link(href=`${callToActionUrl}` style='background: #3d8f44; text-decoration: none; ; color: #ffffff; border-radius: 8px; display:inline-block; mso-padding-alt:0;text-underline-color:none;font-size:Arial, sans-serif;letter-spacing:3.2px;font-size:12px;')
                          //if mso
                            i(style='letter-spacing: 25px;mso-font-width:-100%;mso-text-raise:20pt')  
                          span(style='mso-text-raise:10pt;font-weight:normal;') FINISH SIGNING UP
                          //if mso
                            i(style='letter-spacing: 25px;mso-font-width:-100%')  
                  tr
                    td(style='text-align:center;padding-top:36px')
                      div(style='display:inline-block;width:90%;max-width:590px;vertical-align:top;font-family:Arial,sans-serif;font-size:20px;line-height:32px;color:#666666;')
                        p(style='margin-top:0px')
                          | Column/ is a new social network that values signal over noise: each individual Column is meant to be the best source of news, information, and conversation on that topic.
                        p(style='margin-top:0px')
                          | Looking forward to seeing you there!
                  tr
                    td(style='padding:40px 30px 0px 36px;text-align:center;font-size:24px;font-weight:bold;')
                      a(href=`${callToActionUrl}` style='text-decoration:none;')
                        img(style='width:311px;max-width:392px;height:auto;border:none;text-decoration:none;color:#ffffff;' src=`https://column-static.s3.us-east-2.amazonaws.com/column-snapshots/${columnSlug}.png` alt='Column')
                  tr
                    td(style='padding:0px 30px 50px 30px;text-align:center;font-size:24px;font-weight:bold;')
                      a(href='https://joincolumn.com' style='text-decoration:none;')
                        img(style='width:80%;max-width:392px;height:auto;border:none;text-decoration:none;color:#ffffff;' src='https://column-static.s3.us-east-2.amazonaws.com/Shape.png' alt='Logo')
              table(role='presentation' style='width:100%;max-width:750px;max-border:none;border-spacing:0;text-align:center;font-family:Arial,sans-serif;line-height:22px;margin-top:0px;margin-bottom:32px')
                tbody
                  tr
                    td(style='text-align:center;')
                      .left_buffer(style='text-align:left;width:180px;')
                        p(style='color:#999999;font-family:Arial, sans-serif;font-size:20px;')
                          | Yours Sincerely,
                        img(style='max-width:150px;height:auto;border:none;text-decoration:none;color:#ffffff;' src='https://column-static.s3.us-east-2.amazonaws.com/Signature.png')
                        p(style='color:#999999;font-family:Arial, sans-serif;font-size:16px;')
                          | Social Secretary & Editor
                          br
                          |  in Chief Column/
                    td(style='text-align:center;')
                      img(style='max-width:150px;height:auto;border:none;text-decoration:none;color:#ffffff;' src='https://column-static.s3.us-east-2.amazonaws.com/Circle+Stamp.png')
              //if mso
