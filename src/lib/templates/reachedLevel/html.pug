extends ../newBasicEmailSeven

block header_template
  p.top_buffer(style='\
  font-family: Times, sans-serif;\
  white-space: nowrap;\
  letter-spacing: 4px;\
  ')
    | LEVEL UP

block upper_text_content
  div(style='\
  display: inline-block;\
  width: 90%;\
  max-width: 590px;\
  vertical-align: top;\
  font-family: Arial, sans-serif;\
  font-size: 20px;\
  color: #666666;\
  ')
    p(style='margin-top: 0px; line-height: 32px')
      | You have reached Level #{level_number} in #{expertise}!

block img_content
  div(style='display:inline-block;width:90%;max-width:590px;vertical-align:top;font-family:Arial,sans-serif;font-size:20px;color:#666666;min-height:186px;background-color:#FDFBF7;border-radius:12px')
    //if mso
      table(role='presentation' width='100%')
        tbody
          tr
            td(style='width:145px;' align='left' valign='top')
    .col-sml(style='display:inline-block;width:100%;max-width:140px;vertical-align:top;text-align:left;')
      img(src='https://column-static.s3.us-east-2.amazonaws.com/Level5Email.png' style='height:122px;width:108px;margin-top:32px;margin-left:32px')
    //if mso
    .col-lge(style='display:inline-block;width:100%;max-width:350px;vertical-align:top;padding-bottom:20px;margin-left:32px; margin-top:16px')
      p(style='font-family:Times New roman, sans-serif; letter-spacing:2px;font-size:32px;color:#3D8F44;max-width:75vw;line-height:38px;text-transform:uppercase;')
        | #{expertise}
      p(style='font-family:Times New roman, sans-serif; letter-spacing:2px;font-size:32px;color:#3D8F44')
        | LEVEL #{level_number}
    //if mso


block button_content
  p(style='margin: 0; text-align: left')
    a.button_link(href=`${actionLink}` style='\
    background: #3d8f44;\
    text-decoration: none;\
    color: #ffffff;\
    border-radius: 8px;\
    display: inline-block;\
    mso-padding-alt: 0;\
    text-underline-color: none;\
    font-size: Arial, sans-serif;\
    letter-spacing: 3.2px;\
    font-size: 12px;\
    ')
      //if mso
        i(style='\
        letter-spacing: 25px;\
        mso-font-width: -100%;\
        mso-text-raise: 20pt;\
        ')  
        //
          [endif]
      span(style='mso-text-raise: 10pt; font-weight: normal') MY REPUTATION LEVELS
      //if mso
        i(style='letter-spacing: 25px; mso-font-width: -100%')  
        //
          [endif]

